{
  "name": "gc-pipeline-benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "Internal benchmark & auto-tuning framework for TileSmith GC Pipeline",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-benchmark.mjs",
    "ground-truth": "node scripts/generate-ground-truth.mjs",
    "generate-benchmark": "npm run generate",
    "test:import": "tsx internal/test-import.ts",
    "benchmark": "tsx runners/runner-a-scoring/score.ts",
    "case-study": "tsx scripts/case-study-batch.ts",
    "tune:scoring": "tsx runners/runner-a-scoring/optimize.ts",
    "optimize:scoring": "npm run tune:scoring",
    "tune:pipeline": "tsx runners/runner-b-pipeline/optimize.ts",
    "optimize:pipeline": "npm run tune:pipeline",
    "validate": "node scripts/validate-results.mjs",
    "validate-results": "npm run validate",
    "export-public": "bash scripts/export-public.sh",
    "export:public": "npm run export-public",
    "core:check": "bash scripts/check-core-submodule.sh",
    "core:smoke": "tsx internal/test-import.ts",
    "assets:pixel-fetch": "python3 scripts/fetch-pixel-base-tiles.py",
    "assets:hd-fetch": "bash scripts/fetch-hd-reference-assets.sh",
    "assets:verify": "python3 scripts/verify-pixel-base-tiles.py",
    "test:baseline": "node scripts/test-pipeline-on-perfect.mjs",
    "test": "tsx --test tests/*.test.ts",
    "case-audit": "tsx scripts/audit-delivery-format.ts",
    "case-correlate": "tsx scripts/analyze-correlation.ts"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
